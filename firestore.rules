rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー個人セーブデータ: 認証済み本人のみ読み書き可能
    match /users/{userId}/saves/{saveId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 迷宮踏破の殿堂: 全員読み取り可能、作成は認証済みユーザーのみ（10KB未満）
    match /hall_of_fame/{docId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.adventurerName is string
                    && request.resource.data.level is int
                    && request.resource.data.size() < 10000;
      allow update, delete: if false; // 改ざん・削除不可
    }
  }
}
