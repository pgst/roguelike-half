{
  "post-tool-formatter": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/antigravity-lint-hook.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

